# Server-side credential. Keep the real value in .env.local or a deployment
# secret store; never commit it.
OPENAI_API_KEY=your_openai_api_key_here

# Luna is the lower-cost development default. Terra remains compatible.
OPENAI_MODEL=gpt-5.6-luna

# Local server port. Render supplies PORT automatically in production.
PORT=5174

# Public build-time study settings. These must never contain private data.
VITE_STUDY_MODE=false
VITE_STUDY_INCLUDE_TRANSCRIPTION=false
